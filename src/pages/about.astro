---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import type { TopicCategorySlug } from "../lib/categories";
import {
	getStatusIcon,
	getStatusLabel,
	getTopicCategoryLabel,
} from "../lib/categories";

const [topics, roundups] = await Promise.all([
	getCollection("topics"),
	getCollection("roundups"),
]);

const portfolioTopics = topics
	.filter((t) => t.data.portfolio)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sortedRoundups = roundups.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="About | My Site">
  <div class="max-w-5xl mx-auto px-8 py-16">
    <p class="text-sm text-muted tracking-widest uppercase mb-2 font-semibold">About</p>
    <h1 class="text-3xl font-extrabold text-text mb-10">経歴・実績</h1>

    <section class="mb-14 max-w-2xl">
      <h2 class="text-lg font-extrabold text-text mb-4">経歴</h2>
      <p class="text-sm text-text/80 leading-relaxed font-medium">
        柴犬好き、元薬剤師のエンジニアです。技術的なことや日々の学びを発信しています。
      </p>
      <p class="text-sm text-muted mt-3 font-medium italic">（詳細な経歴は加筆予定）</p>
    </section>

    <section class="mb-14">
      <h2 class="text-lg font-extrabold text-text mb-4">何ができるか</h2>
      {portfolioTopics.length === 0 ? (
        <p class="text-sm text-muted">まだポートフォリオ表示対象のトピックがありません。</p>
      ) : (
        <ul class="space-y-3">
          {portfolioTopics.map((topic) => (
            <li>
              <a
                href={`/topics/${topic.data.slug}`}
                class="group flex items-center justify-between bg-surface border border-border rounded-2xl px-5 py-4 hover:border-brand/60 transition-colors"
              >
                <div class="flex items-center gap-2">
                  <span
                    class="flex items-center justify-center w-5 h-5 text-sm leading-none bg-brand/10 border border-brand/30 text-brand rounded-full"
                    title={getStatusLabel(topic.data.status)}
                  >
                    {getStatusIcon(topic.data.status)}
                  </span>
                  <span class="text-xs px-2 py-0.5 bg-surface border border-border text-muted rounded-full font-semibold">
                    {getTopicCategoryLabel(topic.data.category as TopicCategorySlug)}
                  </span>
                  <span class="text-sm font-bold text-text group-hover:text-brand transition-colors">
                    {topic.data.title}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section>
      <h2 class="text-lg font-extrabold text-text mb-4">どんな活動をしているか</h2>
      {sortedRoundups.length === 0 ? (
        <p class="text-sm text-muted">まだ活動記録がありません。</p>
      ) : (
        <ul class="space-y-3">
          {sortedRoundups.map((roundup) => (
            <li>
              <a
                href={`/roundups/${roundup.id}`}
                class="group flex items-center justify-between bg-surface border border-border rounded-2xl px-5 py-4 hover:border-brand/60 transition-colors"
              >
                <div>
                  <p class="text-sm font-bold text-text group-hover:text-brand transition-colors">
                    {roundup.data.title}
                  </p>
                  <p class="text-xs text-muted mt-1 font-medium">
                    {roundup.data.summarizes.length}件のtopicsをまとめ
                  </p>
                </div>
                <span class="text-xs text-muted ml-6 shrink-0 font-medium">
                  {roundup.data.date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Layout>
