---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const roundups = (await getCollection("roundups")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Roundups | My Site">
  <div class="max-w-5xl mx-auto px-8 py-16">
    <p class="text-sm text-muted tracking-widest uppercase mb-2 font-semibold">Roundups</p>
    <h1 class="text-3xl font-extrabold text-text mb-10">まとめ記事一覧</h1>

    <ul class="space-y-3">
      {roundups.map(roundup => (
        <li>
          <a
            href={`/roundups/${roundup.id}`}
            class="group flex items-center justify-between bg-surface border border-border rounded-2xl px-5 py-4 hover:border-brand/60 transition-colors"
          >
            <div>
              <p class="text-sm font-bold text-text group-hover:text-brand transition-colors">
                {roundup.data.title}
              </p>
              <p class="text-xs text-muted mt-1 font-medium">
                {roundup.data.summarizes.length}件のtopicsをまとめ
              </p>
            </div>
            <span class="text-xs text-muted ml-6 shrink-0 font-medium">
              {roundup.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
