---
interface Node {
	id: string;
	title: string;
	category: string;
	color: string;
	status: "exploring" | "practicing";
	count: number;
}

interface Edge {
	source: string;
	target: string;
	directed: boolean;
}

interface Props {
	nodes: Node[];
	edges: Edge[];
}

const { nodes, edges } = Astro.props;
const data = JSON.stringify({ nodes, edges });
---

<div class="relative w-full aspect-[16/10] bg-surface border border-border rounded-2xl overflow-hidden">
  <svg id="roadmap-svg" class="w-full h-full"></svg>
</div>
<script type="application/json" id="roadmap-data" set:html={data} />

<script>
  import * as d3 from "d3"

  interface Node extends d3.SimulationNodeDatum {
    id: string
    title: string
    category: string
    color: string
    status: "exploring" | "practicing"
    count: number
  }

  interface Edge {
    source: string | Node
    target: string | Node
    directed: boolean
  }

  const dataEl = document.getElementById("roadmap-data")
  const { nodes, edges } = JSON.parse(dataEl?.textContent ?? '{"nodes":[],"edges":[]}') as {
    nodes: Node[]
    edges: Edge[]
  }

  const svgEl = document.getElementById("roadmap-svg") as SVGSVGElement | null
  if (svgEl && nodes.length > 0) {
    const width = svgEl.clientWidth || 800
    const height = svgEl.clientHeight || 500

    const svg = d3.select(svgEl).attr("viewBox", `0 0 ${width} ${height}`)

    svg
      .append("defs")
      .append("marker")
      .attr("id", "roadmap-arrow")
      .attr("viewBox", "0 -5 10 10")
      .attr("refX", 20)
      .attr("refY", 0)
      .attr("markerWidth", 6)
      .attr("markerHeight", 6)
      .attr("orient", "auto")
      .append("path")
      .attr("d", "M0,-5L10,0L0,5")
      .attr("fill", "#80806a")

    const statusOpacity: Record<Node["status"], number> = {
      exploring: 0.5,
      practicing: 1,
    }
    const radius = (d: Node) => 10 + Math.min(d.count, 6) * 3

    const zoomLayer = svg.append("g")

    const link = zoomLayer
      .append("g")
      .selectAll("line")
      .data(edges)
      .join("line")
      .attr("stroke", "#80806a")
      .attr("stroke-width", 1.5)
      .attr("marker-end", (d) => (d.directed ? "url(#roadmap-arrow)" : null))

    const node = zoomLayer
      .append("g")
      .selectAll("circle")
      .data(nodes)
      .join("circle")
      .attr("r", radius)
      .attr("fill", (d) => d.color)
      .attr("fill-opacity", (d) => statusOpacity[d.status] ?? 0.7)
      .attr("stroke", (d) => d.color)
      .attr("stroke-width", 1.5)
      .style("cursor", "pointer")
      .on("click", (_event, d) => {
        window.location.href = `/topics/${d.id}`
      })

    node.append("title").text((d) => `${d.title}`)

    const label = zoomLayer
      .append("g")
      .selectAll("text")
      .data(nodes)
      .join("text")
      .text((d) => d.title)
      .attr("font-size", 11)
      .attr("fill", "#e8e8d8")
      .attr("text-anchor", "middle")
      .style("pointer-events", "none")

    const simulation = d3
      .forceSimulation(nodes)
      .force(
        "link",
        d3
          .forceLink<Node, Edge>(edges)
          .id((d) => d.id)
          .distance(90)
      )
      .force("charge", d3.forceManyBody().strength(-220))
      .force("center", d3.forceCenter(width / 2, height / 2))
      .force(
        "collision",
        d3.forceCollide<Node>().radius((d) => radius(d) + 20)
      )
      .on("tick", ticked)

    function ticked() {
      link
        .attr("x1", (d) => (d.source as Node).x ?? 0)
        .attr("y1", (d) => (d.source as Node).y ?? 0)
        .attr("x2", (d) => (d.target as Node).x ?? 0)
        .attr("y2", (d) => (d.target as Node).y ?? 0)
      node.attr("cx", (d) => d.x ?? 0).attr("cy", (d) => d.y ?? 0)
      label
        .attr("x", (d) => d.x ?? 0)
        .attr("y", (d) => (d.y ?? 0) - (radius(d) + 6))
    }

    const drag = d3
      .drag<SVGCircleElement, Node>()
      .on("start", (event, d) => {
        if (!event.active) simulation.alphaTarget(0.3).restart()
        d.fx = d.x
        d.fy = d.y
      })
      .on("drag", (event, d) => {
        d.fx = event.x
        d.fy = event.y
      })
      .on("end", (event, d) => {
        if (!event.active) simulation.alphaTarget(0)
        d.fx = null
        d.fy = null
      })
    node.call(drag)

    svg.call(
      d3
        .zoom<SVGSVGElement, unknown>()
        .scaleExtent([0.5, 3])
        .on("zoom", (event) => {
          zoomLayer.attr("transform", event.transform)
        })
    )
  }
</script>
